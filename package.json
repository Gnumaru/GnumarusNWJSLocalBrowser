{
  "name": "nwjs-local-browser",
  "version": "0.1.0",
  "description": "NW.js app that serves a local directory over HTTP and browses it.",
  "main": "index.html",
  "scripts": {
    "build": "tsc && tsc -p showcase/filemanager/tsconfig.json",
    "build:app": "tsc",
    "build:showcase": "tsc -p showcase/filemanager/tsconfig.json",
    "start": "npm run build && nw .",
    "test:server": "node ./dist/server.test.js",
    "dist": "npm run build && nwbuild --mode=build --version=0.118.0 --flavor=normal --platform=linux,win,osx --arch=x64 --outDir=./release \"./package.json ./index.html ./dist/** ./assets/** ./showcase/**\"",
    "dist:linux": "npm run build && nwbuild --mode=build --version=0.118.0 --flavor=normal --platform=linux --arch=x64 --outDir=./release \"./package.json ./index.html ./dist/** ./assets/** ./showcase/**\""
  },
  "window": {
    "title": "NW.js Local Browser",
    "width": 1280,
    "height": 800,
    "min_width": 800,
    "min_height": 600,
    "nodejs": true,
    "allownw": true
  },
  "node-remote": [
    "http://localhost:1024/*",
    "http://127.0.0.1:1024/*"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "nw": "0.118.0",
    "nw-builder": "4.24.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "nw@0.118.0": true
  }
}
